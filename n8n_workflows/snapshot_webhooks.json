        "options": {
          "noResponseBody": false
        }
      },
      "id": "webhook-region1",
      "name": "Webhook: Region 1",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ],
      "webhookId": "region1-snapshot"
    },
    {
      "parameters": {
        "filePath": "/data/flight_snapshots/region1_latest.json",
        "options": {}
      },
      "id": "read-region1-snapshot",
      "name": "Read Region 1 Snapshot",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse JSON and return as response\nconst items = $input.all();\n\nif (items.length === 0) {\n  return [{\n    json: {\n      error: 'No snapshot data available',\n      region: 'region1',\n      timestamp: new Date().toISOString()\n    }\n  }];\n}\n\nfor (const item of items) {\n  try {\n    // Get the binary data\n    const binaryData = item.binary.data;\n    const jsonString = Buffer.from(binaryData, 'base64').toString('utf8');\n    const snapshotData = JSON.parse(jsonString);\n    \n    return [{\n      json: snapshotData\n    }];\n  } catch (error) {\n    return [{\n      json: {\n        error: 'Failed to parse snapshot data',\n        details: error.message,\n        region: 'region1',\n        timestamp: new Date().toISOString()\n      }\n    }];\n  }\n}\n\nreturn items;"
      },
      "id": "parse-json-region1",
      "name": "Parse JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      },
      "id": "respond-region1",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        900,
        300
      ]
    },
